Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

# Canonical host and protocol for production.
RewriteCond %{HTTP_HOST} ^www\.organizr\.it$ [NC]
RewriteRule ^ https://organizr.it%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^organizr\.it$ [NC]
RewriteRule ^ https://organizr.it%{REQUEST_URI} [R=301,L]

# Maintenance mode must stay disabled for SEO: redirecting public pages to
# maintenance.html (noindex) prevents indexing of the canonical pages.
# Do not reintroduce the removed client-side maintenance-gate.js script.
# To re-enable server-side maintenance temporarily, uncomment the following block and keep it short-lived.
# RewriteCond %{QUERY_STRING} !(^|&)preview=ZAwNoPDllgzVhHBNFsVpFvJItCnYUDkxjotsyLgUgOfUBkiBnD(&|$)
# RewriteCond %{HTTP_COOKIE} !(^|;\ *)maintenance_override=true(;|$)
# RewriteCond %{REQUEST_URI} !^/maintenance\.html$ [NC]
# RewriteCond %{REQUEST_URI} !^/assets/ [NC]
# RewriteCond %{REQUEST_URI} !^/robots\.txt$ [NC]
# RewriteCond %{REQUEST_URI} !^/sitemap\.xml$ [NC]
# RewriteRule ^.*$ /maintenance.html [R=302,L]

# Clean old direct file URLs.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ ./ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html[\s?] [NC]
RewriteRule ^(.+)/index\.html$ $1/ [R=301,L]

RewriteRule ^download\.html$ download/ [R=301,L]

# Allow future simple pages: /nome instead of /nome.html.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType application/octet-stream "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

AddType application/octet-stream .dmg

<FilesMatch "\.(dmg|exe)$">
  Header set Content-Disposition "attachment"
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
