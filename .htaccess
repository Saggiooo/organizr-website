Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

# Canonical host and protocol for production.
RewriteCond %{HTTP_HOST} ^www\.organizr\.it$ [NC]
RewriteRule ^ https://organizr.it%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^organizr\.it$ [NC]
RewriteRule ^ https://organizr.it%{REQUEST_URI} [R=301,L]

# Maintenance mode must stay disabled for SEO: redirecting public pages to
# maintenance.html (noindex) prevents indexing of the canonical pages.
# Do not reintroduce the removed client-side maintenance-gate.js script.
# To re-enable server-side maintenance temporarily, uncomment the following block and keep it short-lived.
# RewriteCond %{QUERY_STRING} !(^|&)preview=ZAwNoPDllgzVhHBNFsVpFvJItCnYUDkxjotsyLgUgOfUBkiBnD(&|$)
# RewriteCond %{HTTP_COOKIE} !(^|;\ *)maintenance_override=true(;|$)
# RewriteCond %{REQUEST_URI} !^/maintenance\.html$ [NC]
# RewriteCond %{REQUEST_URI} !^/assets/ [NC]
# RewriteCond %{REQUEST_URI} !^/robots\.txt$ [NC]
# RewriteCond %{REQUEST_URI} !^/sitemap\.xml$ [NC]
# RewriteRule ^.*$ /maintenance.html [R=302,L]

# Clean old direct file URLs.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ ./ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html[\s?] [NC]
RewriteRule ^(.+)/index\.html$ $1/ [R=301,L]

RewriteRule ^download\.html$ download/ [R=301,L]

# Removed pages (8 October 2026): the nutrition landing pages no longer exist.
RewriteRule ^nutrition/?$ / [R=301,L]
RewriteRule ^it/alimentazione/?$ /it/ [R=301,L]

# Allow future simple pages: /nome instead of /nome.html.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  # CSS/JS are always referenced with a ?v=<hash> that build.py changes on every edit.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/vtt "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType application/octet-stream "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# Without an explicit charset browsers read text/plain (llms.txt, robots.txt) as Windows-1252: "—" becomes "â€”".
AddDefaultCharset utf-8
AddCharset utf-8 .txt .vtt .xml .webmanifest .css .js

AddType application/octet-stream .dmg
# Serve the sitemap as XML, including with nosniff enabled.
AddType application/xml .xml
AddType font/woff2 .woff2
AddType text/vtt .vtt

<FilesMatch "\.(dmg|exe)$">
  Header set Content-Disposition "attachment"
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Baseline CSP: no plugins, no <base> hijacking, no framing by other sites, HTTPS only.
  Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  # Fingerprinted assets (?v=hash) and self-hosted fonts never change under the same URL.
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "^sitemap\.xml$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
